<Layouts.app flash={@flash} current_scope={@current_scope} active_tab={:auth}>
  <div class="paas-card mx-auto max-w-sm space-y-5 p-6">
    <div class="text-center">
      <.header>
        Log in
        <:subtitle>
          <%= cond do %>
            <% @current_scope -> %>
              You need to reauthenticate to perform sensitive actions on your account.
            <% CleatDeploy.Accounts.registration_allowed?() -> %>
              Don't have an account?
              <.link
                navigate={~p"/users/register"}
                class="font-semibold text-hd-orange hover:underline"
              >
                Sign up
              </.link>
            <% true -> %>
          <% end %>
        </:subtitle>
      </.header>
    </div>

    <.form for={@form} id="login_form" action={~p"/users/log-in"}>
      <.input
        readonly={!!@current_scope}
        field={@form[:email]}
        type="email"
        label="Email"
        autocomplete="username"
        spellcheck="false"
        required
        phx-mounted={JS.focus()}
      />
      <.input
        field={@form[:password]}
        type="password"
        label="Password"
        autocomplete="current-password"
        spellcheck="false"
        required
      />
      <.button
        class="paas-btn-primary mt-4 w-full justify-center py-2.5"
        name={@form[:remember_me].name}
        value="true"
      >
        Log in and stay logged in
      </.button>
      <.button class="paas-btn-secondary mt-2 w-full justify-center py-2.5">
        Log in only this time
      </.button>
    </.form>

    <div
      :if={!@current_scope and CleatDeploy.Accounts.registration_allowed?()}
      class="border-t border-hd-border pt-4"
    >
      <p class="mb-3 text-center text-xs text-hd-muted">New to Cleat?</p>
      <.link
        id="signup-link"
        navigate={~p"/users/register"}
        class="paas-btn-secondary flex w-full justify-center py-2.5"
      >
        <.icon name="hero-user-plus" class="size-4" /> Create account
      </.link>
    </div>
  </div>
</Layouts.app>
