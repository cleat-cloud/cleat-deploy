# Litestream config for the Cleat panel SQLite file.
# Installed to /etc/cleat_deploy/litestream.yml (mode 600).
#
# The file replica is the default: it survives accidental deletes on the
# live path. Production (gestaobem-cx33) replicates every app SQLite file to
# Backblaze B2 bucket cleat-litestream-phoenix via the S3-compatible API
# (endpoint s3.us-east-005.backblazeb2.com, force-path-style). Do not point
# this sidecar at AWS S3: ListBucket on 27 DBs at sync-interval 1s ran
# ~US$54/month. Credentials live in /etc/cleat_deploy/litestream.env.
#
#   replica:
#     type: s3
#     bucket: cleat-litestream-phoenix
#     path: panel
#     region: us-east-005
#     endpoint: s3.us-east-005.backblazeb2.com
#     force-path-style: true
#
dbs:
  - path: /var/lib/cleat_deploy/cleat.db
    replica:
      type: file
      path: /var/backups/cleat_deploy/litestream
